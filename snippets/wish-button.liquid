<button
  type="button"
  class="wishlist-toggle-btn button button--secondary"
  data-product-handle="{{ product.handle }}"
  aria-pressed="false"
  aria-label="Add {{ product.title | escape }} to wishlist"
  style="width: 100%; margin-top: 10px; display: flex; align-items: center; justify-content: center; gap: 8px;"
>
  <span class="wishlist-icon" aria-hidden="true">♡</span>
  <span class="wishlist-text">Add to Wishlist</span>
</button>