{%- doc -%}
  Product card layout styles. Kept in a standalone snippet so empty filtered grids
  can preload the styles before facets morph product cards into the section.

  @example
  {% render 'product-card-styles' %}
{%- enddoc -%}

{% stylesheet %}
  .product-grid__card.product-grid__card {
    display: flex;
    flex-flow: column nowrap;
    gap: var(--product-card-gap);
    align-items: var(--product-card-alignment);
    text-decoration: none;
    color: var(--color, var(--color-foreground));
    padding-block: var(--padding-block-start) var(--padding-block-end);
    padding-inline: var(--padding-inline-start) var(--padding-inline-end);
    overflow: hidden;
  }

  .product-grid__card swatches-variant-picker-component overflow-list::part(list) {
    flex-wrap: wrap;
  }

  /*
    Product cards are narrow, so group content stacks on mobile. A group that
    turns "vertical on mobile" off renders without .mobile-column and keeps the
    horizontal direction it was given.
  */
  .product-grid__card .group-block > :is(.mobile-column, :not(.layout-panel-flex--row)) {
    @media screen and (max-width: 749px) {
      flex-direction: column;
    }
  }

  /* Collection and product list cards have equal heights */
  :is(.product-grid__item, .resource-list__item) .product-card {
    display: grid;
    height: 100%;
  }

  /* Product card title truncation - applied on mobile regardless of view */
  @media screen and (max-width: 749px) {
    :is(.product-card, .product-grid__card) :is(h4, .h4) {
      display: -webkit-box;
      -webkit-box-orient: vertical;
      overflow: hidden;
      text-overflow: ellipsis;
      -webkit-line-clamp: 3;
    }
  }

  .product-card__placeholder-image svg {
    height: 100%;
  }

  .product-card__content slideshow-component {
    --cursor: pointer;
  }

  @media screen and (max-width: 749px) {
    .product-card slideshow-arrows .slideshow-control {
      display: none;
    }
  }


/* =========================================
   WISHLIST HEART ICON ON PRODUCT IMAGE
   ========================================= */

.card-wrapper,
.product-card {
  position: relative;
}

.card-wrapper .card__inner,
.product-card .card__inner {
  position: relative;
}

/* Heart button */
.card-wrapper .card-heart-icon,
.product-card .card-heart-icon {
  position: absolute !important;
  top: 12px;
  right: 12px;
  bottom: auto;

  width: 40px;
  height: 40px;

  display: flex;
  align-items: center;
  justify-content: center;

  background: #fff;
  color: #e0245e;

  border: none;
  border-radius: 50%;

  cursor: pointer;
  z-index: 20;

  opacity: 0;
  visibility: hidden;
  pointer-events: none;

  transition: all 0.25s ease;
}

/* Show heart on image hover */
.card-wrapper:hover .card-heart-icon,
.product-card:hover .card-heart-icon {
  opacity: 1;
  visibility: visible;
  pointer-events: auto;
}

/* Heart SVG */
.card-heart-icon svg {
  width: 21px;
  height: 21px;
}

/* Heart hover effect */
.card-heart-icon:hover {
  background: #e0245e;
  color: #fff;
  transform: scale(1.1);
}

/* Always show on touch devices */
@media (hover: none) {
  .card-wrapper .card-heart-icon,
  .product-card .card-heart-icon {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }
}


/* =========================================
   WISHLIST HEART ICON ON PRODUCT IMAGE
   ========================================= */

.product-grid__card {
  position: relative;
}

/* Default hidden state */
.product-grid__card .card-heart-icon {
  position: absolute !important;
  top: 12px;
  right: 12px;
  z-index: 30;

  width: 40px;
  height: 40px;

  display: flex;
  align-items: center;
  justify-content: center;

  padding: 0;
  border: none;
  border-radius: 50%;

  background: #ffffff;
  color: #e0245e;

  cursor: pointer;

  opacity: 0;
  visibility: hidden;
  pointer-events: none;

  transition: all 0.25s ease;
}

/* Heart icon */
.product-grid__card .wishlist-icon {
  font-size: 27px;
  line-height: 1;
}

/* Show heart on product card hover */
.product-grid__card:hover .card-heart-icon {
  opacity: 1;
  visibility: visible;
  pointer-events: auto;
}

/* Heart hover effect */
.product-grid__card .card-heart-icon:hover {
  background: #e0245e;
  color: #ffffff;
  transform: scale(1.1);
}

/* Mobile visibility */
@media (hover: none) {
  .product-grid__card .card-heart-icon {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }
}

/* =========================================
   PERFECTLY ROUND WISHLIST HEART BUTTON
   ========================================= */

.product-grid__card .card-heart-icon {
  position: absolute !important;
  top: 12px !important;
  right: 12px !important;

  width: 40px !important;
  min-width: 40px !important;
  max-width: 40px !important;

  height: 40px !important;
  min-height: 40px !important;
  max-height: 40px !important;

  aspect-ratio: 1 / 1 !important;

  padding: 0 !important;
  margin: 0 !important;

  border: none !important;
  border-radius: 50% !important;

  box-sizing: border-box !important;

  display: flex !important;
  align-items: center !important;
  justify-content: center !important;

  background: #ffffff;
  color: #e0245e;

  line-height: 1 !important;
  flex: 0 0 40px !important;

  z-index: 30;
}

/* Heart icon alignment */
.product-grid__card .card-heart-icon .wishlist-icon {
  display: block;
  font-size: 24px;
  line-height: 1;
  padding: 0;
  margin: 0;
}

/* Hover effect */
.product-grid__card .card-heart-icon:hover {
  background: #e0245e;
  color: #ffffff;
  transform: scale(1.08);
}

/* Mobile size */
@media screen and (max-width: 749px) {
  .product-grid__card .card-heart-icon {
    width: 36px !important;
    min-width: 36px !important;
    max-width: 36px !important;
    height: 36px !important;
    min-height: 36px !important;
    max-height: 36px !important;
    flex-basis: 36px !important;
  }
}

{% endstylesheet %}
