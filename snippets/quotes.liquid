{%- if product != blank -%}
  {%- assign quote_variant = product.selected_or_first_available_variant -%}
  {%- assign quote_form_id = 'QuoteContactForm-' | append: section.id | append: '-' | append: product.id -%}

  {{ 'quotes.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'quotes.js' | asset_url }}" defer></script>

  <div class="quotes" data-quotes>
    <button
      type="button"
      class="quotes__trigger"
      data-quote-open
      aria-haspopup="dialog"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M21 11.5a8.4 8.4 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.4 8.4 0 0 1-3.8-.9L3 21l1.9-5.7a8.4 8.4 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.4 8.4 0 0 1 3.8-.9h.5a8.5 8.5 0 0 1 8 8v.5Z"/>
      </svg>
      Request a Quote
    </button>

    <dialog class="quotes__modal" data-quote-modal>
      <div class="quotes__modal-content">

        <button
          type="button"
          class="quotes__close"
          data-quote-close
          aria-label="Close quote form"
        >
          &times;
        </button>

        <div class="quotes__header">
          <h2>Request a Quote</h2>
          <p>Tell us what you need and our team will get back to you.</p>
        </div>

        {% form 'contact', id: quote_form_id, class: 'quotes__form' %}

          <div
            class="quotes__form-state"
            data-quote-form-state
            data-success="{% if form.posted_successfully? %}true{% else %}false{% endif %}"
            data-has-errors="{% if form.errors %}true{% else %}false{% endif %}"
          ></div>

          {% if form.posted_successfully? %}

            <div class="quotes__success" role="status">
              <h3>Thank you for your enquiry!</h3>
              <p>Your quote request has been sent successfully. Our team will contact you soon.</p>
            </div>

          {% else %}

            {% if form.errors %}
              <div class="quotes__errors" role="alert">
                {{ form.errors | default_errors }}
              </div>
            {% endif %}

            <input
              type="hidden"
              name="contact[Product]"
              value="{{ product.title | escape }}"
            >

            <input
              type="hidden"
              name="contact[Product URL]"
              value="{{ shop.url }}{{ product.url }}"
            >

            <input
              type="hidden"
              name="contact[Variant ID]"
              value="{{ quote_variant.id }}"
            >

            <div class="quotes__field">
              <label for="QuoteName-{{ product.id }}">Full Name *</label>
              <input
                id="QuoteName-{{ product.id }}"
                type="text"
                name="contact[name]"
                placeholder="Enter your full name"
                autocomplete="name"
                required
              >
            </div>

            <div class="quotes__field">
              <label for="QuoteEmail-{{ product.id }}">Email Address *</label>
              <input
                id="QuoteEmail-{{ product.id }}"
                type="email"
                name="contact[email]"
                placeholder="Enter your email address"
                autocomplete="email"
                autocorrect="off"
                autocapitalize="off"
                required
              >
            </div>

            <div class="quotes__field">
              <label for="QuotePhone-{{ product.id }}">Phone Number</label>
              <input
                id="QuotePhone-{{ product.id }}"
                type="tel"
                name="contact[phone]"
                placeholder="Enter your phone number"
                autocomplete="tel"
              >
            </div>

            <div class="quotes__field">
              <label for="QuoteQuantity-{{ product.id }}">Quantity Required *</label>
              <input
                id="QuoteQuantity-{{ product.id }}"
                type="number"
                name="contact[Quantity]"
                value="1"
                min="1"
                step="1"
                required
              >
            </div>

            <div class="quotes__field">
              <label for="QuoteMessage-{{ product.id }}">Your Message *</label>
              <textarea
                id="QuoteMessage-{{ product.id }}"
                name="contact[body]"
                rows="4"
                placeholder="Tell us more about your requirements..."
                required
              ></textarea>
            </div>

            <button type="submit" class="quotes__submit">
              Submit Quote Request
            </button>

            <p class="quotes__note">
              Our team will contact you using the details provided.
            </p>

          {% endif %}

        {% endform %}
      </div>
    </dialog>
  </div>
{%- endif -%}
